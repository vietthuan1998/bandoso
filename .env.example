# Sao chép file này thành ".env" (đã gitignore) rồi điền giá trị thật.
# hostPattern là chuỗi regex nên phải escape dấu chấm (\.).

# Xác thực tải style/tile bản đồ map.huecity.vn:8280 (Basic)
MAP_TILE_AUTH_HOST_PATTERN=map\.huecity\.vn:8280
MAP_TILE_AUTH_HEADER=Basic <base64-user:pass>

# Nguồn dữ liệu dcu.huecity.vn — chỉ còn hostPattern để nhận diện request
# cần gắn header xác thực (xem src/config/mapTileAuth.ts). Token không còn
# là biến môi trường tĩnh nữa — accessToken lấy qua đăng nhập phiên
# (src/auth/authClient.ts), không bao giờ nằm trong bundle build.
DCU_HOST_PATTERN=dcu\.huecity\.vn

# Base URL + timeout (ms) cho axios client gọi API backend (src/services/api/httpClient.ts)
API_BASE_URL=<https://api-domain-cua-ban>
API_TIMEOUT=15000

# (Tuỳ chọn) Token Bearer tĩnh gắn cho mọi request tới API_BASE_URL — gồm tile
# MVT và items Directus — khi CHƯA đăng nhập (host tile trả 403 nếu thiếu
# token). Token phiên đăng nhập luôn được ưu tiên. CẢNH BÁO: giá trị này bị
# build vào bundle JS, ai có file APK/IPA đều đọc được — chỉ dùng token quyền
# đọc tối thiểu và thu hồi được. Để trống nếu không dùng.
API_ACCESS_TOKEN=
