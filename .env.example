# Sao chép file này thành ".env" (đã gitignore) rồi điền giá trị thật.
# Biến được react-native-dotenv build thẳng vào bundle JS: sau khi sửa phải
# chạy lại Metro với `npx react-native start --reset-cache`. Không đặt bí mật
# cấp quyền dữ liệu ở đây — ai có APK/IPA đều đọc được.
# Thêm/bớt biến nhớ cập nhật kiểu trong env.d.ts.

# Xác thực tải style/tile bản đồ nền map.huecity.vn:8280 (Basic).
# hostPattern là chuỗi regex nên phải escape dấu chấm (\.).
MAP_TILE_AUTH_HOST_PATTERN=map\.huecity\.vn:8280
MAP_TILE_AUTH_HEADER=Basic <base64-user:pass>

# Gốc API BFF, không có "/" ở cuối. App tự nối (src/constants/url.ts):
#   /v1/...                     auth, map, catalog, statistics, reports
#   /directus/items/{collection} dữ liệu Directus
#   /directus/mvt/...           tile lớp dữ liệu (thay host của tileUrl registry)
# BFF tự gắn xác thực cho Directus nên client không giữ token nào.
BASE_URL=https://dcudata.cgb.vn/api

# Timeout (ms) cho các request axios
API_TIMEOUT=15000
