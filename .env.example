# Sao chép file này thành ".env" (đã gitignore) rồi điền giá trị thật.
# hostPattern là chuỗi regex nên phải escape dấu chấm (\.).

# Xác thực tải style/tile bản đồ map.huecity.vn:8280 (Basic)
MAP_TILE_AUTH_HOST_PATTERN=map\.huecity\.vn:8280
MAP_TILE_AUTH_HEADER=Basic <base64-user:pass>

# Nguồn dữ liệu dcu.huecity.vn (Bearer)
DCU_HOST_PATTERN=dcu\.huecity\.vn
DCU_BEARER_TOKEN=<bearer-token>
