# Sao chép file này thành ".env" (đã gitignore) rồi điền giá trị thật.
# hostPattern là chuỗi regex nên phải escape dấu chấm (\.).

# Xác thực tải style/tile bản đồ map.huecity.vn:8280 (Basic)
MAP_TILE_AUTH_HOST_PATTERN=map\.huecity\.vn:8280
MAP_TILE_AUTH_HEADER=Basic <base64-user:pass>

# Host dcu.huecity.vn (tile MVT + items Directus) — hostPattern để nhận diện
# request cần gắn header xác thực (src/services/map/mapTileAuth.ts). Token
# gắn vào là accessToken của phiên đăng nhập (src/services/auth/authClient.ts);
# xem API_ACCESS_TOKEN bên dưới cho trường hợp host chưa nhận token phiên.
DCU_HOST_PATTERN=dcu\.huecity\.vn

# Base URL + timeout (ms) cho axios client gọi API backend (src/services/api/httpClient.ts)
API_BASE_URL=<https://api-domain-cua-ban>
API_TIMEOUT=15000

# (Tuỳ chọn, TẠM THỜI) Token Bearer tĩnh DỰ PHÒNG cho API_BASE_URL (tile MVT +
# items Directus): dùng khi chưa đăng nhập, hoặc khi host trả 401 cho
# accessToken của phiên (host hiện chưa nhận token BFF). accessToken luôn được
# thử trước — xem src/services/api/directusAuth.ts.
# CẢNH BÁO: tài liệu API mục 5 cấm để token trong mã client; giá trị này bị
# build vào bundle JS, ai có file APK/IPA đều đọc được. Chỉ dùng token quyền
# đọc tối thiểu, thu hồi được, và để trống ngay khi backend cho host nhận
# token phiên hoặc có proxy.
API_ACCESS_TOKEN=
